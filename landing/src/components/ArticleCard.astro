---
import { articlePath, formatDate, readingMinutes, summaryOf, type Article } from '../data/articles';

interface Props {
  article: Article;
  /** The first card on a page loads its image eagerly. */
  eager?: boolean;
}

const { article: a, eager = false } = Astro.props;
const href = articlePath(a);
---

<article class="card">
  <a class="media" href={href} tabindex="-1" aria-hidden="true">
    {
      a.cover ? (
        <img
          src={a.cover.thumb}
          srcset={`${a.cover.thumb} 600w, ${a.cover.full} 1600w`}
          sizes="(max-width: 560px) 100vw, (max-width: 1000px) 50vw, 420px"
          alt=""
          width={a.cover.width}
          height={a.cover.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <span class="ph">Best Builders</span>
      )
    }
  </a>
  <div class="body">
    <p class="meta">
      <time datetime={a.published_at}>{formatDate(a.published_at)}</time> · {readingMinutes(a)} min read
    </p>
    <h3><a href={href}>{a.title}</a></h3>
    <p class="sum">{summaryOf(a)}</p>
    <a class="more" href={href} aria-label={`Read: ${a.title}`}>Read article →</a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }
  .card:hover {
    border-color: rgba(243, 220, 174, 0.35);
  }
  .media {
    display: block;
    aspect-ratio: 1.91 / 1;
    overflow: hidden;
    background: var(--bg-2);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .card:hover .media img {
    transform: scale(1.03);
  }
  .ph {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--disp);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
    color: var(--gold);
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px 24px 26px;
  }
  .meta {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }
  h3 {
    font-size: 21px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 12px 0 10px;
  }
  h3 a:hover {
    color: var(--gold-2);
  }
  .sum {
    color: var(--mut);
    font-size: 15px;
    line-height: 1.6;
    flex: 1;
  }
  .more {
    margin-top: 18px;
    color: var(--gold-2);
    font-size: 14px;
    font-weight: 600;
  }
</style>
