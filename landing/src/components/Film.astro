---
import { Image } from 'astro:assets';
import { contact, images } from '../data/site';
---

<section class="film" aria-labelledby="film-title">
  <Image src={images.mansion} alt="" widths={[768, 1280, 1920]} sizes="100vw" />
  <div class="content">
    <a class="play" href={contact.facebook} target="_blank" rel="noopener" aria-label="Watch our videos on Facebook">▶</a>
    <span class="kicker">Client Stories</span>
    <h2 id="film-title">Hear it from<br /><span class="gold">our owners.</span></h2>
    <p>Watch site tours and owner stories on our Facebook page</p>
  </div>
</section>

<style>
  .film {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 80px var(--gutter);
  }
  .film > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
  }
  .content {
    position: relative;
  }
  .play {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: var(--grad);
    display: grid;
    place-items: center;
    margin: 0 auto 34px;
    color: #120e07;
    font-size: 30px;
    box-shadow:
      0 0 0 18px rgba(212, 177, 119, 0.15),
      0 0 0 36px rgba(212, 177, 119, 0.07);
    transition: transform 0.3s ease;
  }
  .play:hover {
    transform: scale(1.06);
  }
  h2 {
    font-size: clamp(40px, 6vw, 72px);
    line-height: 0.95;
    margin-top: 16px;
  }
  p {
    color: #cfc8bb;
    margin-top: 16px;
  }
  @media (max-width: 900px) {
    .film {
      min-height: 480px;
    }
    .play {
      width: 84px;
      height: 84px;
      font-size: 24px;
    }
  }
</style>
