---
import { Image, getImage } from 'astro:assets';
import type { GalleryImage } from '../data/site';

interface Props {
  items: GalleryImage[];
  title: string;
}

const { items, title } = Astro.props;
// Large versions for the full-screen viewer, generated at build time.
const full = await Promise.all(items.map((i) => getImage({ src: i.image, width: Math.min(i.image.width, 1800), format: 'webp' })));
const wideIndex = items.findIndex((i) => i.image.width > i.image.height * 1.4);
---

<div class="gal" data-gallery>
  {
    items.map((item, i) => (
      <a
        class:list={['g', { wide: i === wideIndex }]}
        href={full[i]!.src}
        data-index={i}
        aria-label={`View photo ${i + 1} of ${items.length}: ${item.alt}`}
      >
        <Image
          src={item.image}
          alt={item.alt}
          widths={i === wideIndex ? [640, 1000, 1400] : [360, 540, 720]}
          sizes={i === wideIndex ? '(max-width: 900px) 100vw, 1264px' : '(max-width: 560px) 50vw, (max-width: 900px) 50vw, 33vw'}
          loading="lazy"
        />
      </a>
    ))
  }
</div>

<dialog class="lb" aria-label={title} data-lightbox>
  <img alt="" />
  <p class="cap"></p>
  <button class="x" type="button" aria-label="Close" data-close>×</button>
  <button class="nav prev" type="button" aria-label="Previous photo" data-step="-1">‹</button>
  <button class="nav next" type="button" aria-label="Next photo" data-step="1">›</button>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement | null;
    if (!dialog?.matches('[data-lightbox]')) return;
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const img = dialog.querySelector('img')!;
    const cap = dialog.querySelector<HTMLElement>('.cap')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current]!;
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      cap.textContent = `${img.alt} · ${current + 1} / ${links.length}`;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => show(current + Number(b.dataset.step))),
    );
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
  });
</script>

<style>
  .gal {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .g {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    aspect-ratio: 3 / 4;
    background: var(--card);
    cursor: zoom-in;
  }
  .g.wide {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 7;
  }
  .g img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .g:hover img {
    transform: scale(1.04);
  }

  .lb {
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    overflow: visible;
    color: var(--txt);
  }
  .lb::backdrop {
    background: rgba(5, 5, 5, 0.92);
  }
  .lb img {
    max-width: min(92vw, 1400px);
    max-height: 82vh;
    width: auto;
    height: auto;
    border-radius: 6px;
  }
  .cap {
    margin-top: 12px;
    text-align: center;
    font-size: 14px;
    color: var(--mut);
  }
  .lb button {
    position: fixed;
    background: rgba(20, 20, 18, 0.85);
    border: 1px solid rgba(243, 220, 174, 0.3);
    color: var(--gold-2);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }
  .x {
    top: 20px;
    right: 20px;
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .prev {
    left: 20px;
  }
  .next {
    right: 20px;
  }

  @media (max-width: 900px) {
    .gal {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .g.wide {
      aspect-ratio: 16 / 9;
    }
    .nav {
      top: auto;
      bottom: 20px;
      transform: none;
    }
  }
</style>
