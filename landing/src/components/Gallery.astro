---
import { Image, getImage } from 'astro:assets';
import Modal from './Modal.astro';
import type { GalleryImage, GalleryLayout } from '../data/site';

interface Props {
  items: GalleryImage[];
  title: string;
}

const { items, title } = Astro.props;
// Large versions for the full-screen viewer, generated at build time.
const full = await Promise.all(items.map((i) => getImage({ src: i.image, width: Math.min(i.image.width, 1800), format: 'webp' })));
const layoutOf = (i: GalleryImage): GalleryLayout => i.layout ?? (i.image.width > i.image.height * 1.15 ? 'wide' : 'tall');
// Rendered tile widths; desktop values are capped at the 1264px content width.
const sizing = {
  full: { widths: [640, 1000, 1400], sizes: '(max-width: 1360px) calc(100vw - 40px), 1264px' },
  wide: { widths: [640, 900, 1200], sizes: '(max-width: 900px) calc(100vw - 40px), min(66vw, 845px)' },
  tall: { widths: [360, 540, 720], sizes: '(max-width: 900px) 50vw, min(33vw, 412px)' },
} satisfies Record<GalleryLayout, { widths: number[]; sizes: string }>;
---

<div class="gal-c" data-gallery>
  <div class="gal">
    {
      items.map((item, i) => {
        const layout = layoutOf(item);
        return (
          <a
            class:list={['g', layout]}
            href={full[i]!.src}
            data-index={i}
            aria-label={`View photo ${i + 1} of ${items.length}: ${item.alt}`}
          >
            <Image
              src={item.image}
              alt={item.alt}
              widths={sizing[layout].widths}
              sizes={sizing[layout].sizes}
              loading="lazy"
            />
          </a>
        );
      })
    }
  </div>
</div>

<Modal label={title} data-lightbox>
  <img class="photo" alt="" />
  <p class="cap"></p>
  <button class="nav prev" type="button" aria-label="Previous photo" data-step="-1">‹</button>
  <button class="nav next" type="button" aria-label="Next photo" data-step="1">›</button>
</Modal>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement | null;
    if (!dialog?.matches('[data-lightbox]')) return;
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const img = dialog.querySelector('img')!;
    const cap = dialog.querySelector<HTMLElement>('.cap')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current]!;
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      cap.textContent = `${img.alt} · ${current + 1} / ${links.length}`;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => show(current + Number(b.dataset.step))),
    );
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
  });
</script>

<style>
  /* Row height = width of a 3:4 portrait tile. */
  .gal-c {
    container-type: inline-size;
  }
  .gal {
    --cols: 3;
    --gap: 14px;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-auto-rows: calc((100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols) * 4 / 3);
    gap: var(--gap);
  }
  .g {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--card);
    cursor: zoom-in;
  }
  .g.wide {
    grid-column: span 2;
  }
  .g.full {
    grid-column: 1 / -1;
  }
  .g img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .g:hover img {
    transform: scale(1.04);
  }

  .photo {
    max-width: min(92vw, 1400px);
    max-height: 82vh;
    width: auto;
    height: auto;
    border-radius: 6px;
  }
  .cap {
    margin-top: 12px;
    text-align: center;
    font-size: 14px;
    color: var(--mut);
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .prev {
    left: 20px;
  }
  .next {
    right: 20px;
  }

  @media (max-width: 900px) {
    .gal {
      --cols: 2;
      --gap: 10px;
    }
    .nav {
      top: auto;
      bottom: 20px;
      transform: none;
    }
  }
</style>
