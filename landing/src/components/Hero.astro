---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { contact, enquiryOptions, images } from '../data/site';
import LeadForm from './LeadForm.astro';

const leftLinks = [
  { href: '#projects', label: 'Projects' },
  { href: '#projects', label: 'Plots' },
  { href: '#city-walk', label: 'Commercial' },
];
const rightLinks = [
  { href: '#group', label: 'The Group' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="hero">
  <Image
    class="hero-bg"
    src={images.villaTwin}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap">
    <nav aria-label="Main">
      <ul class="links">
        {leftLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <a class="logo" href="/" aria-label="Best Builders & Developers home">
        <Image src={logo} alt="Best Builders & Developers" width={180} height={152} loading="eager" />
      </a>
      <ul class="links right">
        {rightLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a class="phone" href={`tel:${contact.phoneTel}`}>{contact.phoneDisplay}</a></li>
      </ul>
      <details class="menu">
        <summary aria-label="Open menu"><span></span><span></span></summary>
        <div class="menu-panel">
          {[...leftLinks, ...rightLinks].map((l) => <a href={l.href}>{l.label}</a>)}
          <a class="btn btn-gold" href={`tel:${contact.phoneTel}`}>Call {contact.phoneDisplay}</a>
        </div>
      </details>
    </nav>

    <div class="copy">
      <span class="kicker">Faisalabad · Real estate &amp; development</span>
      <h1>Live at<br /><span class="gold">the best</span><br />address.</h1>
      <p>
        Premium plots, villas and commercial spaces along Faisalabad's Canal corridor, from a group that designs,
        builds and furnishes.
      </p>
    </div>
  </div>

  <LeadForm options={enquiryOptions} />
</header>

<style>
  .hero {
    position: relative;
    min-height: 940px;
    overflow: hidden;
    text-align: center;
    padding-bottom: 160px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(7, 7, 7, 0.85) 0%,
      rgba(7, 7, 7, 0.35) 30%,
      rgba(7, 7, 7, 0.5) 60%,
      #070707 100%
    );
  }
  .wrap {
    position: relative;
    z-index: 3;
  }
  nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 24px 0;
  }
  .links {
    display: flex;
    gap: 32px;
    list-style: none;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d8d2c6;
  }
  .links a:hover {
    color: var(--gold-2);
  }
  .links.right {
    justify-content: flex-end;
  }
  .phone {
    color: var(--gold-2);
  }
  .logo img {
    height: 76px;
    width: auto;
  }
  .menu {
    display: none;
  }
  .copy {
    margin-top: 70px;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(40px, 10.5vw, 124px);
    line-height: 0.86;
    margin: 24px 0 30px;
  }
  .copy p {
    font-size: 19px;
    color: #d4cdc0;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-bottom: 0;
      text-align: left;
    }
    nav {
      grid-template-columns: auto 1fr;
      padding: 16px 0;
    }
    .links {
      display: none;
    }
    .logo img {
      height: 54px;
    }
    .menu {
      display: block;
      justify-self: end;
      position: relative;
    }
    .menu summary {
      list-style: none;
      width: 44px;
      height: 44px;
      border: 1px solid var(--line);
      border-radius: 6px;
      display: grid;
      place-content: center;
      gap: 6px;
      cursor: pointer;
      background: rgba(7, 7, 7, 0.5);
    }
    .menu summary::-webkit-details-marker {
      display: none;
    }
    .menu summary span {
      display: block;
      width: 18px;
      height: 1.5px;
      background: var(--gold-2);
    }
    .menu-panel {
      position: absolute;
      right: 0;
      top: 54px;
      width: min(280px, calc(100vw - 40px));
      background: rgba(14, 14, 13, 0.96);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px;
      display: grid;
      gap: 2px;
      text-align: left;
    }
    .menu-panel a:not(.btn) {
      padding: 12px 12px;
      font-size: 14px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .menu-panel .btn {
      margin-top: 8px;
    }
    .copy {
      margin-top: 90px;
      padding-bottom: 36px;
    }
    .copy p {
      font-size: 17px;
      margin: 0;
    }
  }
</style>
