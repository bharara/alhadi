---
import { Image } from 'astro:assets';
import { enquiryOptions, images } from '../data/site';
import LeadForm from './LeadForm.astro';
import Nav from './Nav.astro';
---

<header class="hero">
  <Image
    class="hero-bg"
    src={images.villaTwin}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap">
    <Nav />

    <div class="copy">
      <span class="kicker">Faisalabad · Real estate &amp; development</span>
      <h1>Live at<br /><span class="gold">the best</span><br />address.</h1>
      <p>
        Residential plots at Sitara Villas and Abdullah Gardens, and commercial plots at City Walk, all on Faisalabad's
        Canal corridor. Sold by a group that also designs, builds and furnishes.
      </p>
    </div>
  </div>

  <LeadForm options={enquiryOptions} />
</header>

<style>
  .hero {
    position: relative;
    min-height: 940px;
    overflow: hidden;
    text-align: center;
    padding-bottom: 160px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(7, 7, 7, 0.85) 0%,
      rgba(7, 7, 7, 0.35) 30%,
      rgba(7, 7, 7, 0.5) 60%,
      #070707 100%
    );
  }
  .wrap {
    position: relative;
    z-index: 3;
  }
  .copy {
    margin-top: 70px;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(40px, 10.5vw, 124px);
    line-height: 0.86;
    margin: 24px 0 30px;
  }
  .copy p {
    font-size: 19px;
    color: #d4cdc0;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-bottom: 0;
      text-align: left;
    }
    .copy {
      margin-top: 90px;
      padding-bottom: 36px;
    }
    .copy p {
      font-size: 17px;
      margin: 0;
    }
  }
</style>
