---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { contact, projects } from '../data/site';

const current = Astro.url.pathname;
const leftLinks = projects.map((p) => ({ href: `/${p.slug}/`, label: p.name }));
const rightLinks = [
  { href: '#contact', label: 'Contact' },
];
---

<nav aria-label="Main">
  <ul class="links">
    {leftLinks.map((l) => <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>)}
  </ul>
  <a class="logo" href="/" aria-label="Best Builders & Developers home">
    <Image src={logo} alt="Best Builders & Developers" width={180} height={152} loading="eager" />
  </a>
  <ul class="links right">
    {rightLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    <li><a class="phone" href={`tel:${contact.phoneTel}`}>{contact.phoneDisplay}</a></li>
  </ul>
  <details class="menu">
    <summary aria-label="Open menu"><span></span><span></span></summary>
    <div class="menu-panel">
      {[...leftLinks, ...rightLinks].map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="btn btn-gold" href={`tel:${contact.phoneTel}`}>Call {contact.phoneDisplay}</a>
    </div>
  </details>
</nav>

<style>
  nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 24px 0;
    text-align: left;
  }
  .links {
    display: flex;
    gap: 30px;
    list-style: none;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d8d2c6;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--gold-2);
  }
  .links.right {
    justify-content: flex-end;
  }
  .phone {
    color: var(--gold-2);
  }
  .logo img {
    height: 76px;
    width: auto;
  }
  .menu {
    display: none;
  }

  @media (max-width: 1100px) {
    .links {
      gap: 20px;
      font-size: 12px;
      letter-spacing: 0.1em;
    }
  }

  @media (max-width: 900px) {
    nav {
      grid-template-columns: auto 1fr;
      padding: 16px 0;
    }
    .links {
      display: none;
    }
    .logo img {
      height: 54px;
    }
    .menu {
      display: block;
      justify-self: end;
      position: relative;
      z-index: 10;
    }
    .menu summary {
      list-style: none;
      width: 44px;
      height: 44px;
      border: 1px solid var(--line);
      border-radius: 6px;
      display: grid;
      place-content: center;
      gap: 6px;
      cursor: pointer;
      background: rgba(7, 7, 7, 0.5);
    }
    .menu summary::-webkit-details-marker {
      display: none;
    }
    .menu summary span {
      display: block;
      width: 18px;
      height: 1.5px;
      background: var(--gold-2);
    }
    .menu-panel {
      position: absolute;
      right: 0;
      top: 54px;
      width: min(280px, calc(100vw - 40px));
      background: rgba(14, 14, 13, 0.96);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px;
      display: grid;
      gap: 2px;
    }
    .menu-panel a:not(.btn) {
      padding: 12px;
      font-size: 14px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .menu-panel .btn {
      margin-top: 8px;
    }
  }
</style>
