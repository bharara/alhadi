---
import { Image } from 'astro:assets';
import { contact, statusLabel, type Project } from '../data/site';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const reversed = index % 2 === 1;
const number = String(index + 1).padStart(2, '0');
const fullName = `${project.name} ${project.accent}`;

const waLink = (text: string) => `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(text)}`;
const primaryHref = waLink(
  project.status === 'selling'
    ? `Assalam o Alaikum, I'm interested in ${fullName}. Please share the master plan, prices and availability.`
    : `Assalam o Alaikum, I'd like to register my interest in ${fullName}. Please keep me updated.`,
);
const brochureHref = waLink(`Assalam o Alaikum, please send me the brochure for ${fullName}.`);
---

<section class:list={['panel', { reversed }]} id={project.slug} aria-labelledby={`${project.slug}-title`}>
  <div class="photo">
    <Image src={project.image} alt={project.imageAlt} widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 58vw" />
    <span class="no" aria-hidden="true">{number}</span>
  </div>
  <div class="text">
    <span class:list={['badge', { muted: project.status !== 'selling' }]}>{statusLabel[project.status]}</span>
    <h2 id={`${project.slug}-title`}>{project.name}<br /><span class="gold">{project.accent}</span></h2>
    <p>{project.summary}</p>
    <dl class="spec">
      {
        project.specs.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="row">
      <a class="btn btn-gold" href={primaryHref} target="_blank" rel="noopener">{project.primaryCta}</a>
      {project.showBrochure && <a class="btn btn-outline" href={brochureHref} target="_blank" rel="noopener">Brochure</a>}
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    min-height: 720px;
    border-bottom: 1px solid var(--line);
  }
  .panel.reversed {
    grid-template-columns: 1fr 1.35fr;
  }
  .reversed .photo {
    order: 2;
  }
  .photo {
    position: relative;
    overflow: hidden;
    min-height: 420px;
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s ease;
  }
  .panel:hover .photo img {
    transform: scale(1.03);
  }
  .no {
    position: absolute;
    left: 36px;
    top: 30px;
    font-family: var(--disp);
    font-size: 140px;
    font-weight: 800;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(243, 220, 174, 0.6);
  }
  .text {
    padding: 90px 70px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  h2 {
    font-size: clamp(44px, 5vw, 68px);
    line-height: 0.92;
    margin: 18px 0 20px;
  }
  p {
    color: var(--mut);
    font-size: 17px;
    line-height: 1.7;
    max-width: 460px;
  }
  .spec {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
    margin: 34px 0 38px;
    border-top: 1px solid var(--line);
  }
  .spec div {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mut);
  }
  dd {
    margin-top: 6px;
    font-weight: 500;
    font-size: 16px;
  }
  .badge {
    align-self: flex-start;
    font-size: 12px;
    font-weight: 700;
    padding: 7px 12px;
    border-radius: 3px;
    background: var(--grad);
    color: #120e07;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .badge.muted {
    background: transparent;
    border: 1px solid rgba(243, 220, 174, 0.4);
    color: var(--gold-2);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .panel,
    .panel.reversed {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .reversed .photo {
      order: 0;
    }
    .photo {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
    .no {
      font-size: 84px;
      left: 20px;
      top: 16px;
    }
    .text {
      padding: 36px var(--gutter) 56px;
    }
    .row .btn {
      flex: 1;
    }
  }
</style>
