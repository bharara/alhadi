---
import { waLink } from '../data/site';

interface Props {
  /** Prefilled WhatsApp message. */
  text?: string;
}

const { text = 'Assalam o Alaikum, I would like to know more about your projects.' } = Astro.props;
---

<a class="wa" href={waLink(text)} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
    <path
      fill="currentColor"
      d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.29.6 4.53 1.74 6.5L3 29l6.68-1.75A12.95 12.95 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.8c-1.98 0-3.92-.53-5.61-1.54l-.4-.24-3.97 1.04 1.06-3.86-.26-.4A10.77 10.77 0 0 1 5.22 16c0-5.96 4.85-10.8 10.82-10.8 5.96 0 10.8 4.84 10.8 10.8 0 5.97-4.84 10.8-10.8 10.8Zm5.93-8.09c-.33-.16-1.93-.95-2.23-1.06-.3-.11-.52-.16-.73.16-.22.33-.84 1.06-1.03 1.28-.19.22-.38.24-.7.08-.33-.16-1.38-.51-2.62-1.62-.97-.86-1.62-1.93-1.81-2.25-.19-.33-.02-.5.14-.66.15-.15.33-.38.49-.57.16-.19.22-.33.33-.54.11-.22.05-.41-.03-.57-.08-.16-.73-1.77-1.01-2.42-.26-.63-.53-.55-.73-.56h-.62c-.22 0-.57.08-.87.41-.3.33-1.14 1.11-1.14 2.71s1.17 3.15 1.33 3.36c.16.22 2.3 3.5 5.56 4.91.78.34 1.39.54 1.86.69.78.25 1.49.21 2.05.13.63-.09 1.93-.79 2.2-1.55.27-.76.27-1.41.19-1.55-.08-.14-.3-.22-.62-.38Z"
    ></path>
  </svg>
  <span>WhatsApp</span>
</a>

<style>
  .wa {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 58px;
    padding: 0 22px 0 16px;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.45),
      0 0 0 0 rgba(37, 211, 102, 0.5);
    animation: pulse 2.8s ease-out infinite;
    transition: transform 0.2s ease;
  }
  .wa:hover {
    transform: translateY(-2px) scale(1.03);
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 0 0 rgba(37, 211, 102, 0.5);
    }
    70%,
    100% {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 0 16px rgba(37, 211, 102, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa {
      animation: none;
    }
  }
  @media (max-width: 600px) {
    .wa {
      right: 16px;
      bottom: 16px;
      width: 58px;
      padding: 0;
      justify-content: center;
    }
    .wa span {
      display: none;
    }
  }
</style>
