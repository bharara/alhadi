---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatsTicker from '../components/StatsTicker.astro';
import ProjectPanel from '../components/ProjectPanel.astro';
import Film from '../components/Film.astro';
import Listings from '../components/Listings.astro';
import Group from '../components/Group.astro';
import About from '../components/About.astro';
import Articles from '../components/Articles.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/logo.png';
import { group, projects, stats } from '../data/site';
import { homeGraph } from '../data/schema';

const site = Astro.site!;
const logoUrl = new URL((await getImage({ src: logo, width: 360, format: 'png' })).src, site).href;
---

<Base
  title="Best Builders & Developers | Plots in Sitara Villas, Abdullah Gardens & City Walk Faisalabad"
  description="Residential and commercial plots on Faisalabad's Canal corridor: Sitara Villas Best Block (1–4 Kanal), Abdullah Gardens (5 Marla–7 Kanal) and City Walk commercial on Canal Road. Call 0311-073-1111."
  jsonLd={homeGraph(site, logoUrl)}
>
  <Hero />
  <main>
    <StatsTicker stats={stats} availability="Plots available now in Sitara Villas, Abdullah Gardens & City Walk" />
    <About />
    <section id="projects" aria-labelledby="projects-title">
      <div class="projects-head">
        <div class="wrap">
          <span class="kicker">Our projects</span>
          <h2 id="projects-title">Three projects on the<br /><span class="gold">Canal corridor.</span></h2>
        </div>
      </div>
      {projects.map((project, index) => <ProjectPanel project={project} index={index} />)}
    </section>
    <Listings mode="home" />
    <Film />
    <Articles />
    <Group companies={group} />
  </main>
  <Footer />
</Base>

<style>
  .projects-head {
    padding: 120px 0 56px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .projects-head h2 {
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 0.95;
    margin-top: 14px;
  }
  @media (max-width: 900px) {
    .projects-head {
      padding: 72px 0 36px;
    }
  }
</style>
