---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LeadForm from '../../components/LeadForm.astro';
import ListingCard from '../../components/ListingCard.astro';
import Modal from '../../components/Modal.astro';
import logo from '../../assets/logo.png';
import { contact, enquiryOptions, projects, waLink } from '../../data/site';
import { listingFacts, listingPath, listings, listingMessage, photoSrcset, type Listing } from '../../data/listings';
import { orgId, organization } from '../../data/schema';

export const getStaticPaths = (() => listings.map((listing) => ({ params: { slug: listing.slug }, props: { listing } }))) satisfies GetStaticPaths;

interface Props {
  listing: Listing;
}

const { listing: l } = Astro.props;
const site = Astro.site!;
const url = new URL(listingPath(l), site).href;
const project = projects.find((p) => p.slug === l.project_slug);
const sold = l.status === 'sold';
const [cover, ...rest] = l.photos;
const logoUrl = new URL((await getImage({ src: logo, width: 360, format: 'png' })).src, site).href;
// Properties sit under their town (project page); ones without a town sit under the directory.
const crumbs = [
  { name: 'Home', href: '/' },
  project ? { name: project.name, href: `/${project.slug}/` } : { name: 'Properties', href: '/properties/' },
  { name: l.title, href: listingPath(l) },
];
const related = listings.filter((x) => x.id !== l.id && x.status === 'available' && (l.project_slug ? x.project_slug === l.project_slug : true)).slice(0, 3);
const paragraphs = (l.description ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const waHref = waLink(listingMessage(l, 'ask', url));
const visitHref = waLink(listingMessage(l, 'visit', url));
const description = l.summary ?? `${l.title}: ${listingFacts(l)}${l.project_name ? ` in ${l.project_name}` : ''}, Faisalabad. ${l.price ?? 'Call for price'}.`;

const facts: { label: string; value: string; href?: string }[] = [
  { label: 'Type', value: l.type_label },
  { label: 'Size', value: l.size },
  ...(l.block ? [{ label: 'Block', value: l.block }] : []),
  ...(l.number ? [{ label: 'Number', value: l.number }] : []),
  ...(l.project_name ? [{ label: 'Project', value: l.project_name, href: project ? `/${project.slug}/` : undefined }] : []),
  { label: 'Status', value: sold ? 'Sold' : 'Available' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization(site, logoUrl),
    {
      '@type': 'RealEstateListing',
      '@id': `${url}#listing`,
      url,
      name: l.title,
      description,
      ...(l.photos.length && { image: l.photos.map((p) => p.full) }),
      ...(l.published_at && { datePosted: l.published_at }),
      dateModified: l.updated_at,
      provider: { '@id': orgId(site) },
      offers: {
        '@type': 'Offer',
        availability: sold ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
        description: l.price ?? 'Call for price',
        seller: { '@id': orgId(site) },
      },
      ...(project && { contentLocation: { '@type': 'Place', name: `${project.fullName}, Faisalabad`, url: new URL(`/${project.slug}/`, site).href } }),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, site).href })),
    },
  ],
};
---

<Base
  title={`${l.title}${l.project_name ? ` · ${l.project_name}` : ''} | Best Builders & Developers`}
  description={description}
  image={cover?.full}
  imageSize={cover ? { width: cover.width, height: cover.height } : undefined}
  jsonLd={jsonLd}
  whatsappText={listingMessage(l, 'ask', url)}
  property={l.slug}
>
  <header class="wrap"><Nav /></header>
  <main>
    <section class="wrap top" aria-labelledby="listing-title">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.slice(0, -1).map((c) => <li><a href={c.href}>{c.name}</a></li>)}
          <li aria-current="page">{l.title}</li>
        </ol>
      </nav>
      {
        sold && (
          <p class="sold-banner" role="status">
            This property has been sold. <a href="/properties/">See similar properties →</a>
          </p>
        )
      }
      <span class="kicker">{[l.type_label, l.project_name].filter(Boolean).join(' · ')}</span>
      <h1 id="listing-title">{l.title}</h1>
      <p class="sub">{listingFacts(l)}{l.project_name && <>, {l.project_name}</>}, Faisalabad</p>
    </section>

    {
      cover && (
        <section class="wrap gallery" aria-label="Photos" data-photos>
          <a class="shot main" href={cover.full} data-index="0" aria-label={`View photo 1 of ${l.photos.length}`}>
            <img src={cover.full} srcset={photoSrcset(cover)} sizes="(max-width: 900px) 100vw, 860px" alt={cover.alt ?? l.title} width={cover.width} height={cover.height} fetchpriority="high" />
          </a>
          {rest.length > 0 && (
            <div class="thumbs">
              {rest.map((p, i) => (
                <a class="shot" href={p.full} data-index={i + 1} aria-label={`View photo ${i + 2} of ${l.photos.length}`}>
                  <img src={p.thumb} srcset={photoSrcset(p)} sizes="(max-width: 900px) 50vw, 300px" alt={p.alt ?? l.title} width={p.width} height={p.height} loading="lazy" decoding="async" />
                </a>
              ))}
            </div>
          )}
        </section>
      )
    }
    {
      cover && (
        <Modal label={`${l.title} photos`} data-lightbox>
          <img class="photo" alt="" />
          <p class="cap" />
          {l.photos.length > 1 && (
            <>
              <button class="nav prev" type="button" aria-label="Previous photo" data-step="-1">
                ‹
              </button>
              <button class="nav next" type="button" aria-label="Next photo" data-step="1">
                ›
              </button>
            </>
          )}
        </Modal>
      )
    }

    <section class="wrap body">
      <div class="main-col">
        {
          l.features.length > 0 && (
            <ul class="features" aria-label="Features">
              {l.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          )
        }
        {paragraphs.length > 0 && <div class="desc">{paragraphs.map((p) => <p>{p}</p>)}</div>}
        {paragraphs.length === 0 && l.summary && <div class="desc"><p>{l.summary}</p></div>}
        <dl class="facts">
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <aside class="card" aria-label="Price and contact">
        <span class="kicker">{sold ? 'Sold' : 'Price'}</span>
        <p class="price">{sold ? 'This property has been sold' : (l.price ?? 'Call for price')}</p>
        <div class="stack">
          {
            sold ? (
              <a class="btn btn-gold" href="/properties/">See similar properties</a>
            ) : (
              <>
                <a class="btn btn-gold" href={waHref} target="_blank" rel="noopener">Ask on WhatsApp</a>
                <a class="btn btn-outline" href={`tel:${contact.phoneTel}`}>Call {contact.phoneDisplay}</a>
                <a class="btn btn-outline" href={visitHref} target="_blank" rel="noopener">Book a site visit</a>
              </>
            )
          }
        </div>
        {project && <a class="proj" href={`/${project.slug}/`}>About {project.fullName} →</a>}
      </aside>
    </section>

    {
      !sold && (
        <section class="sec alt" aria-label={`Ask about ${l.title}`}>
          <div class="wrap">
            <span class="kicker">Interested?</span>
            <h2>
              Get a call<br />
              <span class="gold">back today</span>
            </h2>
          </div>
          <div class="form-wrap">
            <LeadForm options={enquiryOptions} selected={project?.fullName} inline />
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="sec" aria-labelledby="more-title">
          <div class="wrap">
            <span class="kicker">More properties</span>
            <h2 id="more-title">
              More in<br />
              <span class="gold">{l.project_name ?? 'our projects'}</span>
            </h2>
            <div class="grid">
              {related.map((x) => (
                <ListingCard listing={x} showProject={!l.project_slug} />
              ))}
            </div>
            <a class="btn btn-outline all" href="/properties/">See all properties →</a>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-photos]').forEach((gallery) => {
    const dialog = document.querySelector<HTMLDialogElement>('dialog[data-lightbox]');
    if (!dialog) return;
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const img = dialog.querySelector('img')!;
    const cap = dialog.querySelector<HTMLElement>('.cap')!;
    let current = 0;
    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current]!;
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      cap.textContent = `${current + 1} / ${links.length}`;
    };
    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(current + Number(b.dataset.step))));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
  });
</script>

<style>
  .top {
    padding-top: 50px;
    padding-bottom: 36px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    list-style: none;
    font-size: 13px;
    color: var(--mut);
    margin-bottom: 26px;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 10px;
    color: var(--gold);
  }
  .crumbs a:hover {
    color: var(--gold-2);
  }
  .sold-banner {
    border: 1px solid rgba(243, 220, 174, 0.35);
    background: rgba(243, 220, 174, 0.06);
    border-radius: 6px;
    padding: 14px 18px;
    margin-bottom: 26px;
    color: var(--txt);
  }
  .sold-banner a {
    color: var(--gold-2);
    font-weight: 600;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(32px, 6vw, 72px);
    line-height: 0.95;
    margin: 16px 0 16px;
    overflow-wrap: anywhere;
  }
  .sub {
    color: #cfc8bb;
    font-size: 17px;
  }

  .gallery {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 12px;
  }
  .shot {
    display: block;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--card);
    cursor: zoom-in;
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .shot:hover img {
    transform: scale(1.03);
  }
  .main {
    aspect-ratio: 3 / 2;
  }
  .thumbs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: min-content;
    gap: 12px;
    align-content: start;
  }
  .thumbs .shot {
    aspect-ratio: 1;
  }
  .gallery:not(:has(.thumbs)) {
    grid-template-columns: 1fr;
  }

  .photo {
    max-width: min(92vw, 1400px);
    max-height: 82vh;
    width: auto;
    height: auto;
    border-radius: 6px;
  }
  .cap {
    margin-top: 12px;
    text-align: center;
    font-size: 14px;
    color: var(--mut);
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .prev {
    left: 20px;
  }
  .next {
    right: 20px;
  }

  .body {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 60px;
    align-items: start;
    padding-top: 56px;
    padding-bottom: 100px;
  }
  .features {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }
  .features li {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(243, 220, 174, 0.3);
    color: var(--gold-2);
    font-size: 14px;
  }
  .desc p {
    color: #cfc8bb;
    font-size: 17px;
    line-height: 1.75;
    white-space: pre-line;
  }
  .desc p + p {
    margin-top: 16px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 36px;
    border-top: 1px solid var(--line);
  }
  .facts div {
    padding: 18px 16px 18px 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mut);
  }
  dd {
    margin-top: 6px;
    font-weight: 600;
  }
  dd a {
    color: var(--gold-2);
  }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 32px;
    position: sticky;
    top: 30px;
  }
  .price {
    font-family: var(--disp);
    font-size: 30px;
    line-height: 1.1;
    margin: 12px 0 24px;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stack {
    display: grid;
    gap: 10px;
  }
  .proj {
    display: inline-block;
    margin-top: 20px;
    color: var(--gold-2);
    font-size: 14px;
  }

  .sec {
    padding: 100px 0;
    border-top: 1px solid var(--line);
  }
  .sec.alt {
    background: var(--bg-2);
  }
  h2 {
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 0.95;
    margin: 14px 0 32px;
  }
  .form-wrap {
    padding: 0 var(--gutter);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .all {
    margin-top: 28px;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 900px) {
    .top {
      padding-top: 24px;
    }
    .gallery,
    .body {
      grid-template-columns: 1fr;
    }
    .thumbs {
      grid-template-columns: repeat(3, 1fr);
    }
    .body {
      gap: 36px;
      padding-top: 36px;
      padding-bottom: 72px;
    }
    .card {
      position: static;
      padding: 26px 20px;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .sec {
      padding: 72px 0;
    }
    .nav {
      top: auto;
      bottom: 20px;
      transform: none;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
