---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ListingCard from '../../components/ListingCard.astro';
import { contact, waLink } from '../../data/site';
import { listingPath, listings } from '../../data/listings';
import { orgId } from '../../data/schema';

const site = Astro.site!;
const projectChips = [...new Map(listings.filter((l) => l.project_slug).map((l) => [l.project_slug!, l.project_name ?? l.project_slug!])).entries()];
const typeChips = [...new Map(listings.map((l) => [l.type, l.type_label])).entries()];
const available = listings.filter((l) => l.status === 'available').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Properties for sale in Faisalabad',
  url: new URL('/properties/', site).href,
  publisher: { '@id': orgId(site) },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: listings.length,
    itemListElement: listings.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.title, url: new URL(listingPath(l), site).href })),
  },
};
const askHref = waLink("Assalam o Alaikum, please share the plots and properties available today.");
---

<Base
  title="Properties for Sale in Faisalabad | Best Builders & Developers"
  description="Plots and properties for sale in Sitara Villas, Abdullah Gardens and City Walk, Faisalabad. See photos, sizes and prices, then message us on WhatsApp."
  image={listings[0]?.photos[0]?.full}
  imageSize={listings[0]?.photos[0] ? { width: listings[0].photos[0].width, height: listings[0].photos[0].height } : undefined}
  jsonLd={jsonLd}
>
  <header class="wrap"><Nav /></header>
  <main>
    <section class="wrap intro" aria-labelledby="dir-title">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">Properties</li>
        </ol>
      </nav>
      <span class="kicker">{available} available now</span>
      <h1 id="dir-title">Properties<br /><span class="gold">for sale</span></h1>
      <p class="lead">
        Hand-picked plots and properties across our projects on Faisalabad's Canal corridor. Can't see what you need? We have more on our books —
        <a class="link" href={askHref} target="_blank" rel="noopener">ask on WhatsApp</a> or call <a class="link" href={`tel:${contact.phoneTel}`}>{contact.phoneDisplay}</a>.
      </p>
    </section>

    {
      listings.length > 0 ? (
        <section class="wrap dir" aria-label="Property listings" data-directory>
          {(projectChips.length > 1 || typeChips.length > 1) && (
            <div class="chips" role="group" aria-label="Filter properties">
              <button type="button" class="chip" aria-pressed="true" data-filter="">
                All
              </button>
              {projectChips.length > 1 &&
                projectChips.map(([slug, name]) => (
                  <button type="button" class="chip" aria-pressed="false" data-filter={`project:${slug}`}>
                    {name}
                  </button>
                ))}
              {typeChips.length > 1 &&
                typeChips.map(([type, label]) => (
                  <button type="button" class="chip" aria-pressed="false" data-filter={`type:${type}`}>
                    {label}
                  </button>
                ))}
            </div>
          )}
          <div class="grid">
            {listings.map((l) => (
              <ListingCard listing={l} />
            ))}
          </div>
          <p class="none" hidden data-none>
            Nothing matches this filter right now.
          </p>
        </section>
      ) : (
        <section class="wrap empty">
          <p>New properties are being added. Message us for today's list.</p>
          <a class="btn btn-gold" href={askHref} target="_blank" rel="noopener">
            Ask on WhatsApp
          </a>
        </section>
      )
    }
  </main>
  <Footer />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-directory]').forEach((dir) => {
    const chips = [...dir.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...dir.querySelectorAll<HTMLElement>('.grid > a')];
    const none = dir.querySelector<HTMLElement>('[data-none]')!;
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const [key, value] = (chip.dataset.filter ?? '').split(':');
        let shown = 0;
        for (const card of cards) {
          const match = !key || card.dataset[key as 'project' | 'type'] === value;
          card.hidden = !match;
          if (match) shown++;
        }
        none.hidden = shown > 0;
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
      });
    }
  });
</script>

<style>
  .intro {
    padding-top: 60px;
    padding-bottom: 50px;
  }
  .crumbs ol {
    display: flex;
    gap: 10px;
    list-style: none;
    font-size: 13px;
    color: var(--mut);
    margin-bottom: 26px;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 10px;
    color: var(--gold);
  }
  h1 {
    font-weight: 800;
    font-size: clamp(40px, 8vw, 96px);
    line-height: 0.9;
    margin: 18px 0 24px;
  }
  .lead {
    color: #cfc8bb;
    font-size: 17px;
    line-height: 1.7;
    max-width: 680px;
  }
  .link {
    color: var(--gold-2);
  }
  .dir {
    padding-bottom: 120px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }
  .chip {
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: #d8d2c6;
    font: 500 14px var(--sans);
    cursor: pointer;
  }
  .chip[aria-pressed='true'] {
    background: var(--grad);
    color: #120e07;
    border-color: transparent;
    font-weight: 600;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .grid > :global([hidden]) {
    display: none;
  }
  .none,
  .empty p {
    color: var(--mut);
    margin-top: 20px;
  }
  .empty {
    padding-bottom: 120px;
  }
  .empty .btn {
    margin-top: 20px;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .intro {
      padding-top: 30px;
    }
  }
</style>
